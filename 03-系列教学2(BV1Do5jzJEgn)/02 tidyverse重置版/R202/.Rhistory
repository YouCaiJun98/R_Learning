ggplot(returndaily, aes(x = SH_return_daily)) +
# 核密度曲线（核心）
geom_density(
fill = "#457B9D",    # 曲线下方填充色
color = "#1D3557",   # 曲线边框色
alpha = 0.7,         # 透明度
linewidth = 1.2      # 线条粗细
) +
# 标题与坐标轴标签
labs(
title = "上证日收益率核密度分布",
x = "日收益率",
y = "密度"
) +
# 主题美化
theme_bw() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),  # 标题居中加粗
axis.title = element_text(size = 12)
)
ggplot(returndaily, aes(x = SH_return_daily)) +
# 直方图（必须设置 y = ..density.. 才能和密度曲线对齐）
geom_histogram(
aes(y = ..density..),      # 关键：把纵轴改成密度尺度
binwidth = 0.002,          # 柱子宽度
fill = "#2E86AB",          # 填充色
color = "white",           # 柱子边框
alpha = 0.7                # 透明度
) +
# 核密度曲线
geom_density(
color = "#E63946",         # 曲线颜色（红色）
linewidth = 1.5            # 线条粗细
) +
# 标题与坐标轴
labs(
title = "上证日收益率分布：直方图 + 核密度曲线",
x = "日收益率",
y = "密度"
) +
# 主题美化
theme_bw() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.title = element_text(size = 12)
)
