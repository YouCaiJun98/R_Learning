# 进行分词
library(jiebaR)
library(tidytext)
## 自定义分词函数（让 tidytext 支持中文）
segment_zh <- function(text) {
segment(text, wk)
}
segment_zh <- function(text) {
segment(text, wk)
}
word_freq <- df %>%
# 对 name 列做中文分词（核心：tidytext）
unnest_tokens(
output = word,
input = name,
token = segment_zh
) %>%
# 清洗无意义词
filter(
str_length(word) >= 2,       # 保留2字及以上
!str_detect(word, "[0-9]"),  # 去掉数字
!word %in% c(                # 停用词（根据你的商品修改）
"吋"
)
) %>%
# 统计词频
count(word, sort = TRUE) %>%
slice_head(n = 60)  # 取前60个高频词
