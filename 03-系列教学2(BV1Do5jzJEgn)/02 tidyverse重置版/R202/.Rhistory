p1 + p2 + p3 + p4
df <- tibble(
category = paste0("柱子_", 1:10),  # 10 个类别
value = sample(5:20, 10, replace = TRUE)  # 随机高度
)
# 2. 生成 10 个彩虹色
my_colors <- rainbow(10)
# 3. 画图
ggplot(df, aes(x = category, y = value, fill = category)) +
geom_col(color = "black", linewidth = 0.3) +  # 柱子加黑边更清晰
scale_fill_manual(values = my_colors) +  # 手动使用 rainbow 色
theme_minimal() +
labs(title = "rainbow 调色板 10 色柱状图",
x = "类别", y = "数值") +
theme(legend.position = "none")  # 不需要图例
df <- tibble(
category = paste0("柱_", 1:10),  # 10个类别
value = 10                       # 高度全部一样
)
# 2. 画图：rainbow 10色 + 等高柱子
ggplot(df, aes(x = category, y = value, fill = category)) +
geom_col(color = "black", linewidth = 0.5) +  # 黑边更清晰
scale_fill_manual(values = rainbow(10)) +     # 彩虹10色
theme_minimal() +
labs(title = "rainbow 调色板 10 色等高柱状图",
x = "类别", y = "") +
theme(legend.position = "none",               # 隐藏图例
plot.title = element_text(hjust = 0.5)) # 标题居中
