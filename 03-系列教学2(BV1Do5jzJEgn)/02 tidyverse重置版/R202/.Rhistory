x <- seq(100, 1000, length.out = 1000)
y <- log(x) + sqrt(x) + x^2
df <- tibble(x, y)
ggplot(df, aes(x = x, y = y)) +
geom_line(linewidth = 1.2, color = "#2E86AB") +  # 平滑曲线
labs(
title = expression(y == log(x) + sqrt(x) + x^2),
x = "x (100 ~ 1000)",
y = "y 值"
) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, size = 14, face = "bold"))
