library(patchwork)  # 专门用于拼图排版
# ====================== 1. 生成标准正态数据 ======================
set.seed(123)
norm_data <- tibble(
x = rnorm(n = 10000, mean = 0, sd = 1)
)
# ====================== 2. 绘制左图：上证收益率 ======================
p1 <- ggplot(returndaily, aes(x = SH_return_daily)) +
geom_histogram(aes(y = ..density..),
binwidth = 0.002, fill = "#2E86AB", color = "white", alpha = 0.7) +
geom_density(color = "#E63946", linewidth = 1.2) +
labs(title = "上证日收益率分布",
x = "日收益率", y = "密度") +
theme_bw() +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
# ====================== 3. 绘制右图：标准正态分布 ======================
p2 <- ggplot(norm_data, aes(x = x)) +
geom_histogram(aes(y = ..density..),
binwidth = 0.1, fill = "#4285F4", color = "white", alpha = 0.7) +
geom_density(color = "#EA4335", linewidth = 1.2) +
labs(title = "标准正态分布 N(0,1)",
x = "样本值", y = "密度") +
theme_bw() +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
# ====================== 4. 左右并排组合 ======================
p1 + p2  # 直接 + 号就是左右排列
library(tidyverse)
library(scales)
hue_pal()(64)
show_col(hue_pal()(64))
show_col(hue_pal()(16))
show_col(hue_pal()(64))
# 查看内置配色方案
## Viridis系调色板
show_col(viridis_pal()(16))          # viridis
show_col(viridis_pal(option="A")(10))# magma
show_col(viridis_pal(option="B")(10))# inferno
show_col(viridis_pal(option="A")(10))# magma
show_col(viridis_pal(option="C")(10))# plasma
## ColorBrewer系调色板
### 定性调色板（Set1、Paired 等）
show_col(brewer_pal(type="qual", palette="Set1")(9))
### 顺序调色板（Blues、Greens）
show_col(brewer_pal(type="seq", palette="Blues")(9))
### 分歧调色板（RdBu、Spectral）
show_col(brewer_pal(type="div", palette="RdBu")(9))
## 灰色系调色板
show_col(grey_pal()(8))
ggplot(df, aes(x = category, y = height)) +
geom_col(
aes(fill = category),       # 按类别上色
color = "white",            # 白色边框（分隔更清晰）
linewidth = 0.5
) +
# 核心：使用 R 内置 rainbow 调色板（10种颜色）
scale_fill_manual(values = rainbow(10)) +
# 去掉图例（不需要）
guides(fill = "none") +
# 标题与坐标轴
labs(
title = "R内置 rainbow 调色板可视化（10色）",
x = "颜色编号",
y = ""
) +
# 主题美化
theme_bw() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.text.y = element_blank(),  # 隐藏y轴文字
axis.ticks.y = element_blank()  # 隐藏y轴刻度
)
