stock %>%
# 第一步：根据上证收盘价分类（<3000 一类，≥3000 一类）
mutate(
price_group = case_when(
SH_closing_price < 3000 ~ "低于3000点",
SH_closing_price >= 3000 ~ "高于等于3000点"
)
) %>%
# 开始画散点图
ggplot(aes(x = SH_closing_price,
y = investor_confidence_index,
shape = price_group,  # 分类决定点型
color = price_group)) +  # 分类决定颜色
# 散点大小调大，更清晰
geom_point(size = 3) +
# 手动设置：不同颜色 + 不同点型
scale_color_manual(values = c("低于3000点" = "#457B9D",
"高于等于3000点" = "#E63946")) +
scale_shape_manual(values = c("低于3000点" = 16,  # 实心圆
"高于等于3000点" = 17)) +  # 实心三角
# 标题与坐标轴
labs(
title = "上证收盘价 vs 投资者信心指数",
x = "上证综指收盘价",
y = "投资者信心指数",
shape = "价格分类",
color = "价格分类"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
legend.position = "bottom"
)
ggplot(stock, aes(x = date)) +
# 第一条折线：上证收盘价 → 蓝色 实线
geom_line(
aes(y = SH_closing_price, color = "上证收盘价", linetype = "上证收盘价"),
linewidth = 1
) +
# 第二条折线：投资者信心指数 → 红色 虚线
geom_line(
aes(y = investor_confidence_index, color = "投资者信心指数", linetype = "投资者信心指数"),
linewidth = 1
) +
# 手动指定颜色
scale_color_manual(
values = c(
"上证收盘价" = "#2E86AB",      # 蓝色
"投资者信心指数" = "#E63946"  # 红色
)
) +
# 手动指定线型（实线 vs 虚线）
scale_linetype_manual(
values = c(
"上证收盘价" = "solid",       # 实线
"投资者信心指数" = "dashed"   # 虚线
)
) +
# 坐标轴与标题
labs(
title = "上证收盘价与投资者信心指数走势对比",
x = "日期",
y = "数值",
color = "指标",
linetype = "指标"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
legend.position = "bottom"
)
ggplot(stock, aes(x = date)) +
# 左图：上证收盘价 (蓝色实线)
geom_line(
aes(y = SH_closing_price),
color = "#2E86AB", linewidth = 1, linetype = "solid"
) +
# 右图：投资者信心指数 (红色虚线)
geom_line(
aes(y = investor_confidence_index),
color = "#E63946", linewidth = 1, linetype = "dashed"
) +
# 核心：左右分栏 + 独立Y轴
facet_wrap(
~factor(1),  # 固定分两栏
ncol = 2,    # 左右排布
axes = "all",# 每个子图保留坐标轴
axis.labels = "all"
) +
# 双Y轴自动适配（关键！解决数值差距大的问题）
scale_y_continuous(
guide = guide_axis(position = "left"),
sec.axis = dup_axis()
) +
# 标题标签
labs(
title = "上证收盘价 & 投资者信心指数（分图展示）",
x = "日期",
y = "数值"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
strip.text = element_blank() # 隐藏子图标题，更干净
)
ggplot(stock, aes(x = date)) +
# 左图：上证收盘价 (蓝色实线)
geom_line(
aes(y = SH_closing_price),
color = "#2E86AB", linewidth = 1, linetype = "solid"
) +
# 右图：投资者信心指数 (红色虚线)
geom_line(
aes(y = investor_confidence_index),
color = "#E63946", linewidth = 1, linetype = "dashed"
) +
# 核心：左右分栏 + 独立Y轴
facet_wrap(
