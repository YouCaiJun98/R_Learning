size = 1.2,
color = "#3182bd"  # 主色调蓝色，和你的图风格一致
) +
# 可选：用颜色映射强化密度效果（和你图的渐变更像）
geom_point(
aes(color = ..n..),
stat = "bin2d",
bins = 50,
size = 1.2,
alpha = 0.7
) +
