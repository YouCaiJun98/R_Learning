color_start <- "blue"# 1. 定义你想要的【两个起始颜色】
color_end   <- "red"
ramp <- colour_ramp(c(color_start, color_end)) # 2. 创建插值函数（关键！）
my_colors <- ramp(seq(0, 1, length.out = 10)) # 3. 生成 10 个插值颜色（你想要多少个就写多少）
show_col(my_colors) # 4. 查看颜色
color_start <- "yellow"# 1. 定义你想要的【两个起始颜色】
color_end   <- "red"
ramp <- colour_ramp(c(color_start, color_end)) # 2. 创建插值函数（关键！）
my_colors <- ramp(seq(0, 1, length.out = 10)) # 3. 生成 10 个插值颜色（你想要多少个就写多少）
show_col(my_colors) # 4. 查看颜色
color_start <- "yellow"# 1. 定义你想要的【两个起始颜色】
color_end   <- "red"
ramp <- colour_ramp(c(color_start, color_end)) # 2. 创建插值函数（关键！）
my_colors <- ramp(seq(0, 1, length.out = 30)) # 3. 生成 10 个插值颜色（你想要多少个就写多少）
