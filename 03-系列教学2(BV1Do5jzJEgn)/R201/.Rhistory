green_cols
# 1、将R中的颜色名称包含'green'的都找出来，
# 并利用条形图将其可视化的表现出来。
all_cols <- colors()
green_cols <- grep("green", all_cols, value=T, ignore.case = TRUE)
n <- length(green_cols)
barplot(height = rep(1, n), col=green_cols, names.arg = green_cols, horiz = T,
las=1, cex.names = 0.5, xaxt='n')
