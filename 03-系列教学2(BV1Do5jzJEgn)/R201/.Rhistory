axis(side = 1, at = 1:30)  # 仅显示x轴刻度
plot(x = 1:30, y = rep(2, 30),
pch = 16, cex = 3,  # 大圆点
col = col_30,       # 30种渐变颜色
main = "30色渐变展示",
xlab = "颜色序号", ylab = "",
axes = FALSE)
