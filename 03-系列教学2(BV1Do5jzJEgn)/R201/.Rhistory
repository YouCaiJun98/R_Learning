describe <- function(x){
m <- mean(x)
v <- var(x)
s <- sd(x)
ske <- skewness(x)
kur <- kurtosis(x)
jar <- jarqueberaTest(x)
p <- jar@test$p.value
return(c('均值'=m, '方差'=v, '标准差'=s,
'偏度'=ske, '峰度'=kur, 'p值'=p))
}
describe(x)
describe(a)
