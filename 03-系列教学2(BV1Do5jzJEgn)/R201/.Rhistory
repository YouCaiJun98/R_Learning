library(dplyr)
mtcars$class <- case_when(
mtcars$wt <= 3 ~ 1,
mtcars$wt < 5 ~ 2,
TRUE ~ 3
)
x <- mtcars$qsec          # 横坐标：qsec
y <- mtcars$wt            # 纵坐标：wt
class_col <- brewer.pal(3, "Set2")[mtcars$class]  # 按class配色
symbols(
x = x,        # 横坐标：qsec
y = y,          # 纵坐标：wt
circles = mtcars$disp,  # 气泡大小由 disp 决定
inches = 0.4,           # 控制气泡最大尺寸（防止太大）
bg = class_col,            # 气泡填充色（按class）
fg = "black",           # 气泡边框色
lwd = 1,                # 边框粗细
main = "气泡图：qsec ~ wt (size=disp, color=class)",
xlab = "qsec",
ylab = "wt"
)
symbols(
x = x,                  # 横坐标：qsec
y = y,                  # 纵坐标：wt
circles = mtcars$disp,  # 气泡大小由 disp 决定
inches = 0.4,           # 控制气泡最大尺寸（防止太大）
bg = class_col,         # 气泡填充色（按class）
fg = "black",           # 气泡边框色
main = "气泡图：qsec ~ wt",
xlab = "qsec",
ylab = "wt"
)
x <- seq(0, 10, length.out = 1000)  # 生成[0,10]的连续自变量
y <- x^3 + sin(x)                   # 计算函数值
plot(x, y,
type = "l", lwd = 2, col = "darkgreen",
main = "f(x) = x^3 + sin(x)，x ∈ [0, 10]",
xlab = "x", ylab = "f(x)")
# 1、将R的内置数据集longley作为本次作业的数据集，
# 将longley数据集变量名为Year的列给删除掉。
data(longley)  # 加载内置数据集
longley
nrows(longley)
ncols(longley)
View(longley)
colnames(longley)
colnames(longley) == "Year"
colnames(longley) != "Year"
longley_ <- longley[, colnames(longley) != "Year"]  # 删除Year列
pairs(longley_,
main = "longley数据集（删除Year后）散点图矩阵",
pch = 16, col = "steelblue")
mdata <- mtcars[c('mpg', "disp", "hp", "drat", "wt")]
pairs(mdata)
pairs(mdata, col='blue', pch=16)
pairs(mdata, col='blue', pch=16, upper.panel = NULL)
panelfunc <- function(x, y) {
points(x, y)
abline(lm(y~x))
}
panelfunc <- function(x, y) {
points(x, y, col='blue')
abline(lm(y~x), col='green')
}
pairs(mdata, panel=panelfunc, col='blue', pch=16, lower.panel = NULL)
pairs(mdata, panel=panelfunc)
mdata <- mtcars[c('mpg', "disp", "hp", "drat", "wt")]
pairs(mdata, col='blue', pch=16, upper.panel = NULL) # 只显示下三角
pairs(mdata, col='blue', pch=16, lower.panel = NULL) # 只显示上三角
## 自定义函数
panelfunc <- function(x, y) {
points(x, y, col='blue')
abline(lm(y~x), col='green')
}
## 线性拟合
pairs(mdata, panel=panelfunc)
spm(mdata)
library(car)
spm(mdata)
spm(mdata)
spm(mdata, smooth=F)
spm(mdata, smooth=F, diagonal=list(method='hisrogram')) # 不画拟合曲线
spm(mdata, smooth=F, diagonal=list(method='histrogram')) # 不画拟合曲线
spm(mdata, smooth=F, diagonal=list(method='histogram')) # 不画拟合曲线
# 相关图像
cor(mdata)
cor(mdata, method="spearman") # spearman相关系数
cor(mdata, method="kendall") # kendall相关系数
library(ggcorrplot)
install.packages(ggcorrplot)
install.packages('ggcorrplot')
library(ggcorrplot)
# 相关图像
corr1 <- cor(mdata) # 皮尔逊相关系数
ggcorrplot(corr1)
ggcorrplot(corr1, lab=T)
ggcorrplot(corr1, lab=T, hc.order = T)
ggcorrplot(corr1, lab=T, hc.order = T, type='lower')
smoothScatter(a, b)
# 散点密度热图
a <- rnorm(5000, 0, 1)
b <- rnorm(5000, 0, 3)
smoothScatter(a, b)
smoothScatter(a, b, cex=2)
smoothScatter(a, b, cex=2, nrpoints = 4) # 查看密度最小的4个点
smoothScatter(a, b, cex=2, nrpoints = Inf) # 查看所有点（密恐警告！）
plot(a, b, col=densCols(a, b))
plot(a, b, col=densCols(a, b), pch=20, cex=1.5) # 用plot画散点密度图
plot(a, b, col=densCols(a, b, colramp = colorRampPalette(c('yellow', 'red'))), pch=20, cex=1.5) # 改变颜色
# 函数图像
curve(log(x) + sqrt(x) + x^q, from=1, to=100, n=1000, main=expression())
# 函数图像
curve(log(x) + sqrt(x) + x^2, from=1, to=100, n=1000, main=expression())
# 函数图像
curve(log(x) + sqrt(x) + x^2, from=1, to=100, n=1000,
main=expression(log(x) + sqrt(x) + x^2))
# 函数图像
curve(log(x) + sqrt(x) + x^2, from=1, to=100, n=1000,
main=expression(log(x) + sqrt(x) + x^2),
ylab = 'y')
data(longley)  # 加载内置数据集
longley_ <- longley[, colnames(longley) != "Year"]  # 删除Year列
# 2、画出数据集longley的散点图矩阵
pairs(longley_,
main = "longley数据集（删除Year后）散点图矩阵",
pch = 16, col = "steelblue")
# 3、计算数据集longley的变量的相关系数，并将相关系数可视化。
corr1 <- cor(longley)
library(ggcorrplot)
ggcorrplot(corr1, lab=T, hc.order = T, type='lower')
curve(x^3 + sin(x), from=0, to=10, n=1000,
main=expression(x^3 + sin(x)),
ylab = 'y')
