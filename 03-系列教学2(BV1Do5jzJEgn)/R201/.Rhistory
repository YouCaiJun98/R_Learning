descword <- segment(description, mixseg)
# 4、查看分词结果中是否有“大内存”，“全面屏” 这两个词汇
# 这里没有是因为前面有G!
'大内存' %in% descword
'全面屏' %in% descword
# 5、统计分词结果descword的词频，将结果保存到变量descfreq
descfreq <- table(descword)
wordcloud2(descfreq)
