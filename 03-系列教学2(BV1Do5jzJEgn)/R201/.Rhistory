col_idx <- cut(mtcars$hp, breaks = length(unique(mtcars$hp)), labels = FALSE)
plot(mtcars$wt, mtcars$disp,
pch = 16, cex = 1.5,
col = col_mtcars[col_idx],
main = "mtcars: wt vs disp (hp越深颜色越深)",
xlab = "wt (车重)", ylab = "disp (排量)")
