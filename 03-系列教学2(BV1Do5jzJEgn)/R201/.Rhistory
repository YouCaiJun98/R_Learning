# 不同区域对应不同颜色
library(dplyr)
mtcars['disp_wt_class'] <- case_when(mtcars$disp > mdisp & mtcars$wt > mwt ~ 1,
mtcars$disp < mdisp & mtcars$wt > mwt ~ 2,
mtcars$disp < mdisp & mtcars$wt < mwt ~ 3,
mtcars$disp > mdisp & mtcars$wt < mwt ~ 4)
