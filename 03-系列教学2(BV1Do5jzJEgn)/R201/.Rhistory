pairs(mdata, col='blue', pch=16, upper.panel = NULL)
panelfunc <- function(x, y) {
points(x, y)
abline(lm(y~x))
}
panelfunc <- function(x, y) {
points(x, y, col='blue')
abline(lm(y~x), col='green')
}
pairs(mdata, panel=panelfunc, col='blue', pch=16, lower.panel = NULL)
pairs(mdata, panel=panelfunc)
mdata <- mtcars[c('mpg', "disp", "hp", "drat", "wt")]
