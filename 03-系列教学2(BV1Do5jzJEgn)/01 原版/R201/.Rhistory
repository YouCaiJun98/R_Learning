# 导入数据
library(readxl)
tianmao <- read_excel("./data/tianmaoTV.xlsx", skip = 1)
# 计算品牌平均价格
aggregate(tianmao$current_price, by=list(tianmao$brand), mean)
# 计算品牌平均价格
aggregate(tianmao$current_price, by=list(brands=tianmao$brand), mean)
# 计算品牌平均价格
price_brands <- aggregate(tianmao$current_price,
by=list(brands=tianmao$brand), mean)
View(price_brands)
