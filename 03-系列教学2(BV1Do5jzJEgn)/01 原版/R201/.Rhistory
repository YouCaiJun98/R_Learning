hist(x, breaks=10, freq=F, col='red', border='white')
lines(density(x), col='blue')
hist(a, freq=F, breaks=100, main='正态分布', col='red', border='white')
lines(density(a, bw=0.5), col='blue')
library(fBasics)
skewness(x)
kurtosis(x)
jar <- jarqueberaTest(x)
jar@test$p.value
describe <- function(x){
m <- mean(x)
v <- var(x)
s <- sd(x)
ske <- skewness(x)
kur <- kurtosis(x)
jar <- jarqueberaTest(x)
p <- jar@test$p.value
return(c('均值'=m, '方差'=v, '标准差'=s,
'偏度'=ske, '峰度'=kur, 'p值'=p))
}
