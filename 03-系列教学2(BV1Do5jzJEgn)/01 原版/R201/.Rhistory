points(stock2$SH_closing_price, stock2$investor_confidence_index,
pch=17, col='green')
plot(stock$SH_closing_price, stock$investor_confidence_index,
col = c('blue', 'green')[stock$label],
pch = c(16, 17)[stock$label])
