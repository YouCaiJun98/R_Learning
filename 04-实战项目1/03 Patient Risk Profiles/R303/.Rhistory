library(tidyverse)
library(ggplot2)
library(reshape2)
risk <- read_csv("./data/patient_risk_profiles.csv")
risk %>%
summarise(
dementia_risk = mean(`predicted risk of Dementia`)
)
View(risk)
risk_long_age <- risk %>%
pivot_longer(
cols = starts_with("age group"),
names_to = "age_group",
values_to = "value"
) %>%
filter(value == 1)
# 按照年龄分组检查风险
risk_long_age %>%
group_by(age_group) %>%
summarise(
mean_dementia_risk =
mean(`predicted risk of Dementia`)
)
ggplot(
risk,
aes(
x = `Hypertension in prior year`,
y = `predicted risk of Pulmonary Embolism`
)
) +
geom_boxplot()
ggplot(
risk,
aes(
x = factor(`Hypertension in prior year`),
y = `predicted risk of Pulmonary Embolism`
)
) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(
alpha = 0.05,
width = 0.2
)
features <- c(
"Hypertension in prior year",
"Obesity in prior year",
"Smoking in prior year",
"Heart failure in prior year",
"Hyperlipidemia in prior year",
"Type 2 Diabetes Mellitus (DM), with no type 1 or secondary DM in prior year"
)
for (feature in features) {
p <- ggplot(
risk,
aes_string(
x = paste0("factor(`", feature, "`)"),
y = "`predicted risk of Pulmonary Embolism`"
)
) +
geom_violin(fill = "skyblue") +
labs(
title = feature,
x = feature,
y = "Predicted risk"
)
print(p)
}
risk_long <- risk %>%
select(
all_of(features),
`predicted risk of Pulmonary Embolism`
) %>%
pivot_longer(
cols = all_of(features),
names_to = "feature",
values_to = "value"
)
ggplot(
risk_long,
aes(
x = factor(value),
y = `predicted risk of Pulmonary Embolism`
)
) +
geom_violin(fill = "skyblue") +
facet_wrap(~ feature, scales = "free_x") +
labs(
x = "Feature present",
y = "Predicted risk"
)
threshold <- quantile(
risk$`predicted risk of Pulmonary Embolism`,
0.9
)
risk <- risk %>%
mutate(
high_pe_risk =
if_else(
`predicted risk of Pulmonary Embolism`
>= threshold,
1,
0
)
)
model <- glm(
high_pe_risk ~
`Hypertension in prior year` +
`Heart failure in prior year` +
`Type 2 Diabetes Mellitus (DM), with no type 1 or secondary DM in prior year`,
family = "binomial",
data = risk
)
# 检查模型
summary(model)
exp(coef(model))
exp(confint(model))
model <- glm(
high_pe_risk ~
`Heart failure in prior year`,
family = "binomial",
data = risk
)
# 检查模型
summary(model)
exp(coef(model))
exp(confint(model))
model_hf_single <- glm(
high_pe_risk ~
`Heart failure in prior year`,
family = "binomial",
data = risk
)
exp(coef(model_hf_single))
model_multi <- glm(
high_pe_risk ~
`Heart failure in prior year` +
`age group: 85 - 89` +
`Hypertension in prior year`,
family = "binomial",
data = risk
)
View(risk)
names(risk)
model_multi <- glm(
high_pe_risk ~
`Heart failure in prior year` +
`age group:  85 -  89` +
`Hypertension in prior year`,
family = "binomial",
data = risk
)
exp(coef(model_multi))
model_multi <- glm(
high_pe_risk ~
`Heart failure in prior year` +
`age group:  80 -  84` +
`Hypertension in prior year`,
family = "binomial",
data = risk
)
exp(coef(model_multi))
model_multi <- glm(
high_pe_risk ~
`Heart failure in prior year` +
`age group:  85 -  89` +
`Hypertension in prior year`,
family = "binomial",
data = risk
)
exp(coef(model_multi))
model <- glm(
high_pe_risk ~
`Hypertension in prior year` +
`Heart failure in prior year` +
`Type 2 Diabetes Mellitus (DM), with no type 1 or secondary DM in prior year`,
family = "binomial",
data = risk
)
exp(coef(model_multi))
exp(coef(model))
summary(model)
predict(model_multi, type = "response")
predict(model_multi, newdata = new_patient, type = "response")
