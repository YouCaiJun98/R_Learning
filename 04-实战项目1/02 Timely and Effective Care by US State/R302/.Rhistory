library(readr)
care <- read_csv("./data/care_state.csv")
head(care)
library(dplyr)
glimpse(care)
care_clean <- care %>%
filter(!is.na(score))
colSums(is.na(care_clean))
library(tidyverse)
care_clean %>%
group_by(condition) %>%
summarise(mean_score = mean(score, na.rm = TRUE)) %>%
ggplot(aes(x = reorder(condition, mean_score), y = mean_score)) +
geom_col(fill = "tomato") +
coord_flip()
