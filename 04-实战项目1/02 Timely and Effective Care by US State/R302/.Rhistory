states <- c("AK", "AL")
cond <- "Emergency Department"
data_compare <- care_clean %>%
filter(
state %in% states,
condition == cond,
)  %>%
group_by(measure_id) %>%
filter(n_distinct(state) == 2) %>%  # 只保留同时存在AK和AL数据的指标
ungroup()
ggplot(data_compare, aes(
x = reorder(measure_id, score),
y = score,
fill = state
)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
coord_flip() +
scale_fill_manual(
values = c("AK" = "tomato", "AL" = "steelblue"),
name = "State"
) +
labs(
x = "指标ID",
y = "Score",
title = "AK vs AL 急诊科指标得分对比"
) +
theme_minimal()
