library(readr)
care <- read_csv("./data/care_state.csv")
head(care)
library(dplyr)
glimpse(care)
care_clean <- care %>%
filter(!is.na(score))
colSums(is.na(care_clean))
library(tidyverse)
care_clean %>%
count(state) %>%
ggplot(aes(x = reorder(state, n), y = n)) +
geom_col() +
coord_flip()
measure_example <- "Median time spent in emergency department before leaving from the visit A lower number of minutes is better"
care_ed <- care_clean %>%
filter(measure_name == measure_example)
care_ed
View(care_ed)
View(care_clean)
measure_example <- "Emergency Department"
care_ed <- care_clean %>%
filter(condition == measure_example)
View(care_ed)
care_ed <- care_clean %>%
filter(condition == measure_example & cond_2 %in% measure_id)
cond_2 <- "OP_18"
care_ed <- care_clean %>%
filter(condition == measure_example & cond_2 %in% measure_id)
View(care_ed)
care_ed <- care_clean %>%
filter(condition == measure_example && cond_2 %in% measure_id)
