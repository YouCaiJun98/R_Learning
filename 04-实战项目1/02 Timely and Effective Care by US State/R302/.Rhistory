library(readr)
care <- read_csv("./data/care_state.csv")
head(care)
library(dplyr)
glimpse(care)
care_clean <- care %>%
filter(!is.na(score))
colSums(is.na(care_clean))
library(tidyverse)
care_clean %>%
group_by(condition) %>%
summarise(mean_score = mean(score, na.rm = TRUE)) %>%
ggplot(aes(x = reorder(condition, mean_score), y = mean_score)) +
geom_col(fill = "tomato") +
coord_flip()
library(readr)
care <- read_csv("./data/care_state.csv")
head(care)
library(dplyr)
glimpse(care)
colSums(is.na(care))
care_clean <- care %>%
filter(!is.na(score))
colSums(is.na(care_clean))
library(tidyverse)
ggplot(care_clean, aes(x = score)) +
geom_histogram(bins = 40, fill = "steelblue")
state <- "AK"
cond <- "Emergency Department"
care_clean %>%
filter(state == state & condition == cond) %>%
summarise(mean_score = mean(score, na.rm = TRUE)) %>%
ggplot(aes(x = reorder(condition, mean_score), y = mean_score)) +
geom_col(fill = "tomato") +
coord_flip()
View(care_clean)
state <- "AK"
cond <- "Emergency Department"
care_clean %>%
filter(state == !!state & condition == !!cond) %>%
summarise(mean_score = mean(score, na.rm = TRUE)) %>%
ggplot(aes(x = reorder(condition, mean_score), y = mean_score)) +
geom_col(fill = "tomato") +
coord_flip()
state <- "AK"
cond <- "Emergency Department"
care_clean %>%
filter(state == state, condition == cond) %>%
summarise(mean_score = mean(score, na.rm = TRUE)) %>%
ggplot(aes(x = reorder(condition, mean_score), y = mean_score)) +
geom_col(fill = "tomato") +
coord_flip()
state_ <- "AK"
cond <- "Emergency Department"
care_clean %>%
filter(state == state_, condition == cond) %>%
ggplot(aes(x = reorder(measure_id, score), y = score)) +
geom_col(fill = "tomato") +
coord_flip()
states <- c("AK", "AL")
cond <- "Emergency Department"
data_compare <- care_clean %>%
filter(
state %in% states,
condition == cond,
)
ggplot(data_compare, aes(
x = reorder(measure_id, score),
y = score,
fill = state
)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
coord_flip() +
scale_fill_manual(
values = c("AK" = "tomato", "AL" = "steelblue"),
name = "State"
) +
labs(
x = "指标ID",
y = "Score",
title = "AK vs AL 急诊科指标得分对比"
) +
theme_minimal()
ggplot(data_compare, aes(
x = reorder(measure_id, score),
y = score,
fill = state
)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
coord_flip() +
