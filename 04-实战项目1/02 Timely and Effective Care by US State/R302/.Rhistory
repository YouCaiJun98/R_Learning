care_clean %>%
select(measure_id, measure_name) %>%  # 只保留这两列
distinct() %>%                        # 去重，每个指标只出现一次
arrange(measure_id) %>%               # 按ID排序，更整齐
print(n = Inf)                        # 全部打印出来
care_clean %>%
select(measure_id, measure_name) %>%  # 只保留这两列
distinct() %>%                        # 去重，每个指标只出现一次
arrange(measure_id) %>%               # 按ID排序，更整齐
print(n = Inf)                        # 全部打印出来
pr_data <- care_clean %>%
filter(state == "PR") %>%
select(measure_id, measure_name, score) %>%
rename(score_PR = score)
# 全美平均分（按指标计算）
national_avg <- care_clean %>%
group_by(measure_id) %>%
summarise(score_national = mean(score, na.rm = TRUE), .groups = "drop")
# 合并 PR + 全美平均
plot_data <- pr_data %>%
left_join(national_avg, by = "measure_id") %>%
# 增加指标好坏方向分组
mutate(
direction = case_when(
measure_id %in% measure_lower_is_better ~ "越低越好（等待时间）",
measure_id %in% measure_higher_is_better ~ "越高越好（达标率）",
TRUE ~ "其他"
)
) %>%
filter(direction != "其他") # 只保留我们分好组的指标
measure_lower_is_better <- c("OP_18b", "OP_18b_HIGH_MIN", "OP_18b_LOW_MIN", "OP_18b_MEDIUM_MIN", "OP_18b_VERY_HIGH_MIN",
"OP_18c", "OP_18c_HIGH_MIN", "OP_18c_LOW_MIN", "OP_18c_MEDIUM_MIN", "OP_18c_VERY_HIGH_MIN",
"OP_23")
measure_higher_is_better <- c("HCP_COVID_19", "IMM_3", "OP_22", "OP_29", "OP_31",
"SAFE_USE_OF_OPIOIDS", "SEP_1", "SEP_SH_3HR", "SEP_SH_6HR", "SEV_SEP_3HR", "SEV_SEP_6HR")
pr_data <- care_clean %>%
filter(state == "PR") %>%
select(measure_id, measure_name, score) %>%
rename(score_PR = score)
# 全美平均分（按指标计算）
national_avg <- care_clean %>%
group_by(measure_id) %>%
summarise(score_national = mean(score, na.rm = TRUE), .groups = "drop")
# 合并 PR + 全美平均
plot_data <- pr_data %>%
left_join(national_avg, by = "measure_id") %>%
# 增加指标好坏方向分组
mutate(
direction = case_when(
measure_id %in% measure_lower_is_better ~ "越低越好（等待时间）",
measure_id %in% measure_higher_is_better ~ "越高越好（达标率）",
TRUE ~ "其他"
)
) %>%
filter(direction != "其他") # 只保留我们分好组的指标
# ====================== 3. 画横向双条形图 ======================
ggplot(plot_data, aes(y = reorder(measure_id, score_PR))) +
# 全美平均条形
geom_col(
aes(x = score_national, fill = "全美平均"),
width = 0.7,
alpha = 0.7
) +
# PR 条形
geom_col(
aes(x = score_PR, fill = "波多黎各（PR）"),
width = 0.4,
position = position_nudge(x = 0)
) +
# 按好坏方向分面（关键！）
facet_wrap(~direction, scales = "free_x") +
# 颜色设置
scale_fill_manual(values = c("波多黎各（PR）" = "tomato", "全美平均" = "steelblue")) +
# 标签与主题
labs(
title = "波多黎各（PR）急诊医疗质量指标 vs 全美平均",
x = "得分",
y = "指标ID",
fill = "组别"
) +
theme_minimal() +
theme(legend.position = "bottom")
plot_data <- care_clean %>%
filter(state %in% c("PR", state.abb)) %>%  # state.abb 包含所有美国州缩写，不含PR
group_by(measure_id) %>%
mutate(
is_pr = ifelse(state == "PR", "波多黎各（PR）", "全美其他州"),
score_national = mean(score[state != "PR"], na.rm = TRUE)
) %>%
ungroup() %>%
filter(state == "PR") %>%
select(measure_id, score_PR = score, score_national) %>%
pivot_longer(
cols = c(score_PR, score_national),
names_to = "group",
values_to = "score"
) %>%
mutate(
group = recode(group, "score_PR" = "波多黎各（PR）", "score_national" = "全美平均"),
direction = case_when(
measure_id %in% measure_lower_is_better ~ "越低越好（等待时间）",
measure_id %in% measure_higher_is_better ~ "越高越好（达标率）"
)
) %>%
filter(!is.na(direction))
ggplot(plot_data, aes(
x = reorder(measure_id, score),
y = score,
fill = group
)) +
geom_col(
position = position_dodge(width = 0.8),
width = 0.7
) +
coord_flip() +
facet_wrap(~direction, scales = "free", ncol = 2) +
scale_fill_manual(
values = c("波多黎各（PR）" = "tomato", "全美平均" = "steelblue"),
name = "组别"
) +
labs(
title = "波多黎各（PR）急诊医疗质量指标 vs 全美平均",
x = "指标ID",
y = "得分"
) +
theme_minimal() +
theme(
legend.position = "bottom",
strip.text = element_text(size = 12, face = "bold")
)
